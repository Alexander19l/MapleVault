# Puerto para el servidor local del backend Express
PORT=5000
MAPLEVAULT_HOST=127.0.0.1

# Configuracion opcional de Electron en desarrollo
MAPLEVAULT_BACKEND_HOST=127.0.0.1
MAPLEVAULT_BACKEND_PORT=5000
MAPLEVAULT_RENDERER_URL=http://127.0.0.1:5173

# Opcional en desarrollo. Electron genera un token aleatorio en producción.
MAPLEVAULT_API_TOKEN=

# Solo habilitar si LibreTranslate u Ollama se ejecutan en otro equipo confiable
MAPLEVAULT_ALLOW_REMOTE_SERVICES=false
MAPLEVAULT_BOT_LOG_MAX_BYTES=2097152

# Configuracion opcional de Maple Assistant
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Traduccion local con LibreTranslate
LIBRETRANSLATE_ENABLED=true
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT_MS=5000
LIBRETRANSLATE_AUTOSTART_COMMAND=
