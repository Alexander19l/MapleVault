{
  "name": "maplevault-backend",
  "version": "1.0.0",
  "description": "Local API server for MapleVault",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "build": "node scripts/clean-dist.js && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:chatbot": "vitest run src/chatbot/__tests__/",
    "test:security": "vitest run src/security/__tests__/",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/sqlite3": "^3.1.11",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "dotenv": "^16.6.1",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
